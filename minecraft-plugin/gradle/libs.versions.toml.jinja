[versions]
kotlin = "2.4.21"
shadow = "8.3.11"
runPaper = "3.0.2"

paper = "{{ minecraft_version }}-R0.1-SNAPSHOT"
{%- if use_kotlinx_libs %}
kotlinxSerializationJson = "1.12.0"
kotlinxCoroutines = "1.11.0"
{%- endif %}

[libraries]
paper-api = { group = "io.papermc.paper", name = "paper-api", version.ref = "paper" }
{%- if use_kotlinx_libs %}

kotlinx-serialization-json = { group = "org.jetbrains.kotlinx", name = "kotlinx-serialization-json", version.ref = "kotlinxSerializationJson" }
kotlinx-coroutines-core = { group = "org.jetbrains.kotlinx", name = "kotlinx-coroutines-core", version.ref = "kotlinxCoroutines" }
{%- endif %}

[plugins]
kotlin-jvm = { id = "org.jetbrains.kotlin.jvm", version.ref = "kotlin" }
{%- if use_serialization_plugin %}
kotlin-serialization = { id = "org.jetbrains.kotlin.plugin.serialization", version.ref = "kotlin" }
{%- endif %}
shadow = { id = "com.gradleup.shadow", version.ref = "shadow" }
run-paper = { id = "xyz.jpenilla.run-paper", version.ref = "runPaper" }