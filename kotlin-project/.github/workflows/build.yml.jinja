name: Build
on:
  workflow_dispatch:
    inputs:
      build_type:
        description: Select build type
        default: debug
        type: choice
        options:
          - debug
          - release

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK {{ jvm_toolchain }}
        uses: actions/setup-java@v4
        with:
          distribution: "temurin"
          java-version: "{{ jvm_toolchain }}"
          cache: "gradle"

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew

      - name: Validate Gradle wrapper
        uses: gradle/actions/wrapper-validation@v4

      - name: Build
        run: ./gradlew build

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: {{ project_name | lower }}
          path: "app/build/libs/{{ project_name }}.jar"

      - name: Create Release
        if: {% raw %}${{ inputs.build_type == 'release' }}{% endraw %}
        uses: svenstaro/upload-release-action@v2
        with:
          file: "app/build/libs/{{ project_name }}.jar"
          tag: latest
          release_name: latest
          overwrite: true